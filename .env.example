#AI_PROVIDER=gemini groq openrouter


# ── FREE image generation models (separate from the chat lists above) ──
# Astra's image pool is FREE/free-tier ONLY. A model is used only when
# astra.ai.image_models has verified (a) it really produces images, (b) the
# id is current in the provider's catalog, (c) Astra has a working adapter
# path, and (d) it is free/free-tier usable. Paid-only, vision-only and
# stale ids are rejected even if listed here.
#
# The FREE pool is: Cloudflare Workers AI (250 free image steps/day) plus the
# single user-requested force-added candidate Google `gemini-2.5-flash-image`
# (used as the dedicated Gemini provider model). OpenRouter's active FREE
# image pool is EMPTY: its live catalog was re-verified on 2026-09-26 and
# contains zero `:free` image-output models, so no OpenRouter id is listed.
# OpenRouter's Image API and Gemini's native image API are both implemented,
# and OpenRouter live discovery still picks up a genuinely free model if one
# ever appears. Each list is optional: when it is empty, Astra uses the
# registry's documented models for that provider, so the lists exist only to
# CHANGE the pool without code edits.
#
# IMPORTANT: the image path runs through the Astra AI Gateway. It now has ITS
# OWN dedicated credentials/base URLs (IMAGE_* below) so image generation
# never has to borrow the chat GW_* pool. When an IMAGE_* var is left empty,
# that piece explicitly falls back to the matching GW_* chat credential/base
# URL/account id (a documented fallback, not an accident) -- so existing
# GW_*-only setups keep working unchanged. A provider-style GEMINI_API_KEYS /
# CLOUDFLARE_API_KEYS / OPENROUTER_API_KEYS value (no GW_/IMAGE_ prefix) is
# still a DIFFERENT system and does NOT make the image pool callable.
# These GW_*_IMAGE_MODELS lists are CANONICAL for actual image generation:
# they configure the Astra AI Gateway connections that ImageRouter (the only
# component that ever performs a real image-generation HTTP call, see
# astra/ai/image_router.py) dispatches to via `gateway.image_targets()`.
GW_CLOUDFLARE_IMAGE_MODELS=@cf/black-forest-labs/flux-1-schnell,@cf/stabilityai/stable-diffusion-xl-base-1.0,@cf/bytedance/stable-diffusion-xl-lightning,@cf/lykon/dreamshaper-8-lcm,@cf/runwayml/stable-diffusion-v1-5-inpainting,@cf/leonardo/lucid-origin,@cf/leonardo/phoenix-1.0
GW_GEMINI_IMAGE_MODELS=gemini-2.5-flash-image
# Intentionally EMPTY. OpenRouter's own catalog had no `:free`-suffixed
# image-output model as of the 2026-09-26 live re-audit (see
# astra/ai/image_models.py), and the three ids previously force-listed here
# were removed after verification (two do not exist in the live catalog at
# all; the third's paid base id is not a substitute). Leave this UNSET/
# empty to use Astra's live discovery of
# https://openrouter.ai/api/v1/images/models, which never invents a model
# and returns nothing while no OpenRouter image model is genuinely free.
GW_OPENROUTER_IMAGE_MODELS=

# These non-GW_*_IMAGE_MODELS lists are a SEPARATE, non-executing system: they
# seed the Provider/ModelRegistry's metadata catalog (astra/ai/models.py) and
# the standalone Provider adapters' (astra/ai/adapters/*.py) own
# `generate_image` mechanics, used directly in their unit tests. They are NOT
# read by ImageRouter and are NOT an alternate way to make the image pool
# callable -- AstraRouter (the normal Provider router) deliberately fails
# closed on any image_generation/image_editing request instead of executing
# it (see astra/ai/router.py), so only the GW_*_IMAGE_MODELS lists above
# affect what image generation actually does. Kept intentionally separate
# rather than merged into the GW_* lists -- do not delete.
CLOUDFLARE_IMAGE_MODELS=@cf/black-forest-labs/flux-1-schnell,@cf/stabilityai/stable-diffusion-xl-base-1.0,@cf/bytedance/stable-diffusion-xl-lightning,@cf/lykon/dreamshaper-8-lcm,@cf/runwayml/stable-diffusion-v1-5-inpainting,@cf/leonardo/lucid-origin,@cf/leonardo/phoenix-1.0
GEMINI_IMAGE_MODELS=gemini-2.5-flash-image
# Intentionally EMPTY -- see GW_OPENROUTER_IMAGE_MODELS above.
OPENROUTER_IMAGE_MODELS=

# ── Dedicated image-generation credentials (NEW) ──────────────────────────
# Optional. Each is consulted ONLY for image generation, completely separate
# from the connection's normal chat GW_*_API_KEYS/GW_*_BASE_URL. The
# *_BASE_URL values below are pre-filled with each provider's real default
# endpoint (same host used for chat, minus Gemini's OpenAI-compat "/openai"
# suffix -- the image path calls Gemini's native :generateContent API) so
# they work out of the box; change them only to point at a proxy/mock. The
# *_API_KEY / *_ACCOUNT_ID values are left empty on purpose: leaving those
# empty falls back to the matching GW_* chat credential/account id
# (documented, intentional -- never an accidental reuse of the chat
# credential's health state, since each pool tracks its own per-key
# health/cooldown). Set them only when you want image generation to use a
# genuinely separate key/account from chat.
IMAGE_CLOUDFLARE_API_KEY=
IMAGE_CLOUDFLARE_ACCOUNT_ID=
IMAGE_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4

IMAGE_OPENROUTER_API_KEY=
IMAGE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

IMAGE_GEMINI_API_KEY=
IMAGE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional: deterministic SERIAL FALLBACK order for FREE image generation.
# Comma-separated model ids, most-preferred first. Image generation performs
# NO proactive health probe and spends NO quota on health checks: Astra simply
# tries these models in order and stops at the first real image response.
# This setting only REORDERS models that already passed the FREE +
# image-generation eligibility checks -- it can never add a paid, vision-only
# or text model to the pool.
# The default order is ONE GLOBAL MODEL LIST (model-by-model, never grouped by
# provider): gemini-2.5-flash-image, @cf/leonardo/lucid-origin,
# @cf/leonardo/phoenix-1.0, flux-1-schnell, sdxl-base-1.0, sd-xl-lightning,
# dreamshaper-8-lcm, sd-v1-5-inpainting. (OpenRouter contributes no static
# entry: its live catalog has zero FREE image models.)
# GW_IMAGE_GENERATION_PRIORITY is the CANONICAL override var (read by
# `AstraAIGateway.image_targets`). IMAGE_GENERATION_PRIORITY (no GW_ prefix)
# is a documented legacy fallback alias, consulted ONLY when
# GW_IMAGE_GENERATION_PRIORITY is unset/empty -- set at most one of the two;
# if both are set, GW_IMAGE_GENERATION_PRIORITY wins and the other is ignored.
# Example override (same single global list, different order/subset):
# GW_IMAGE_GENERATION_PRIORITY=@cf/leonardo/lucid-origin,@cf/black-forest-labs/flux-1-schnell
# IMAGE_GENERATION_PRIORITY=@cf/leonardo/lucid-origin,gemini-2.5-flash-image


# ══════════════ 3. SETTINGS (all optional) ══════════════

# server
PORT=8787
BIND=127.0.0.1
#ASTRA_TOKEN=<MANUAL_SECRET>
#ENV=production

# web server hardening
#ASTRA_API_RATE_LIMIT=300
#ASTRA_MAX_BODY_MB=50
#ASTRA_CORS_ORIGINS=http://localhost:8787 http://127.0.0.1:8787

# web research
#ASTRA_ALLOW_PRIVATE_URLS=0

# Web3 transaction safety
#WEB3_TRANSACTION_MODE=CONFIRM
#WEB3_MAX_TX_VALUE_WEI=1000000000000000000
#WEB3_MAX_DAILY_TX_VALUE_WEI=5000000000000000000
#WEB3_MAX_GAS_LIMIT=8000000
#WEB3_ALLOWED_RECIPIENTS=0x0000000000000000000000000000000000000000
#WEB3_ALLOWED_CONTRACTS=0x1111111111111111111111111111111111111111
#WEB3_ALLOWED_WALLETS=0x2222222222222222222222222222222222222222
#WEB3_CHAIN_IDS=1 8453 137 56 42161 10 11155111

# browser / system
#NO_BROWSER=1

# storage
#DATA_DIR=./data
#ASTRA_SCHEDULER=1
#DATABASE=./data/astra.db
#ASTRA_WORKSPACE=./workspace
#BROWSER_SCREENSHOTS=./data/screenshots

# chat / routing tuning
#CHAT_MAX_TOKENS=
#CHAT_CONTEXT_MAX_CHARS=
#CHAT_CONTEXT_MAX_TURNS=
#AI_MAX_RETRIES=2
#AI_BACKOFF=1.0
#AI_ROUTING_PREFERENCE=fastest
#AI_PROVIDER_LABEL=openai

# permissions
#GRANTED_PERMISSIONS=read low_risk_write browser_action system_action

# shared Terminal
#CHAT_MAX_TOOL_STEPS=8
#CHAT_AGENT_BRAIN=provider
#ASTRA_TERMINAL_SHELL=
#TERMINAL_MAX_OUTPUT_CHARS=20000
#TERMINAL_HISTORY_LIMIT=50

# Astra Agent Runtime
#RUNTIME_CONTAINER=ubuntu
#RUNTIME_PROOT=
#RUNTIME_CONTAINERS_DIR=
#RUNTIME_ROOTFS_MODE=shared
#RUNTIME_DIR=~/.astra/runtime
#RUNTIME_MAX_FILE_MB=512
#RUNTIME_MAX_EXTRACT_MB=2048
#RUNTIME_MAX_MEMBERS=20000
#RUNTIME_BACKEND=auto

# WSL2 backend
#RUNTIME_WSL_DISTRO=Ubuntu
#RUNTIME_WSL_ROOT=/var/lib/astra/runtime
#RUNTIME_WSL_WORKSPACE=
#RUNTIME_WSL_ISOLATE=1
#RUNTIME_WSL_UMASK=000
#RUNTIME_WSL_EXE=

# HOST terminal fallback
#HOST_APPROVAL_TTL_S=900

# Web3 keystore
#ASTRA_MASTER_SECRET=<MANUAL_SECRET>

# FastAPI/ASGI
#ASTRA_ASGI_THREADS=0
#ASTRA_FASTAPI_DOCS=1
