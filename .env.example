#AI_PROVIDER=gemini groq openrouter


# ── FREE image generation models (separate from the chat lists above) ──
# Astra's image pool is FREE/free-tier ONLY. A model is used only when
# astra.ai.image_models has verified (a) it really produces images, (b) the
# id is current in the provider's catalog, (c) Astra has a working adapter
# path, and (d) it is free/free-tier usable. Paid-only, vision-only and
# stale ids are rejected even if listed here.
#
# The FREE pool is: Cloudflare Workers AI (10,000 free Neurons/day) plus the
# user-requested force-added candidates -- Google `gemini-2.5-flash-image`
# and the three OpenRouter `:free` image ids below. OpenRouter's Image API
# and Gemini's native image API are both implemented. Each list is optional:
# when it is empty, Astra uses the registry's documented models for that
# provider, so the lists exist only to CHANGE the pool without code edits.
GW_CLOUDFLARE_IMAGE_MODELS=@cf/black-forest-labs/flux-1-schnell,@cf/stabilityai/stable-diffusion-xl-base-1.0,@cf/bytedance/stable-diffusion-xl-lightning,@cf/lykon/dreamshaper-8-lcm,@cf/runwayml/stable-diffusion-v1-5-inpainting,@cf/leonardo/lucid-origin,@cf/leonardo/phoenix-1.0
GW_GEMINI_IMAGE_MODELS=gemini-2.5-flash-image
GW_OPENROUTER_IMAGE_MODELS=black-forest-labs/flux-1-schnell:free,google/gemini-2.5-flash-image-preview:free,sourceful/riverflow-v2.5-pro:free

CLOUDFLARE_IMAGE_MODELS=@cf/black-forest-labs/flux-1-schnell,@cf/stabilityai/stable-diffusion-xl-base-1.0,@cf/bytedance/stable-diffusion-xl-lightning,@cf/lykon/dreamshaper-8-lcm,@cf/runwayml/stable-diffusion-v1-5-inpainting,@cf/leonardo/lucid-origin,@cf/leonardo/phoenix-1.0
GEMINI_IMAGE_MODELS=gemini-2.5-flash-image
OPENROUTER_IMAGE_MODELS=black-forest-labs/flux-1-schnell:free,google/gemini-2.5-flash-image-preview:free,sourceful/riverflow-v2.5-pro:free

# Optional: deterministic SERIAL FALLBACK order for FREE image generation.
# Comma-separated model ids, most-preferred first. Image generation performs
# NO proactive health probe and spends NO quota on health checks: Astra simply
# tries these models in order and stops at the first real image response.
# This setting only REORDERS models that already passed the FREE +
# image-generation eligibility checks -- it can never add a paid, vision-only
# or text model to the pool.
# The default order is ONE GLOBAL MODEL LIST (model-by-model, never grouped by
# provider): gemini-2.5-flash-image, @cf/leonardo/lucid-origin,
# @cf/leonardo/phoenix-1.0, flux-1-schnell, sdxl-base-1.0, sd-xl-lightning,
# dreamshaper-8-lcm, sd-v1-5-inpainting,
# google/gemini-2.5-flash-image-preview:free,
# black-forest-labs/flux-1-schnell:free, sourceful/riverflow-v2.5-pro:free.
# Example override (same single global list, different order/subset):
# IMAGE_GENERATION_PRIORITY=@cf/leonardo/lucid-origin,gemini-2.5-flash-image,sourceful/riverflow-v2.5-pro:free
# GW_IMAGE_GENERATION_PRIORITY=@cf/leonardo/lucid-origin,black-forest-labs/flux-1-schnell:free


# ══════════════ 3. SETTINGS (all optional) ══════════════

# server
PORT=8787
BIND=127.0.0.1
#ASTRA_TOKEN=<MANUAL_SECRET>
#ENV=production

# web server hardening
#ASTRA_API_RATE_LIMIT=300
#ASTRA_MAX_BODY_MB=50
#ASTRA_CORS_ORIGINS=http://localhost:8787 http://127.0.0.1:8787

# web research
#ASTRA_ALLOW_PRIVATE_URLS=0

# Web3 transaction safety
#WEB3_TRANSACTION_MODE=CONFIRM
#WEB3_MAX_TX_VALUE_WEI=1000000000000000000
#WEB3_MAX_DAILY_TX_VALUE_WEI=5000000000000000000
#WEB3_MAX_GAS_LIMIT=8000000
#WEB3_ALLOWED_RECIPIENTS=0x0000000000000000000000000000000000000000
#WEB3_ALLOWED_CONTRACTS=0x1111111111111111111111111111111111111111
#WEB3_ALLOWED_WALLETS=0x2222222222222222222222222222222222222222
#WEB3_CHAIN_IDS=1 8453 137 56 42161 10 11155111

# browser / system
#NO_BROWSER=1

# storage
#DATA_DIR=./data
#ASTRA_SCHEDULER=1
#DATABASE=./data/astra.db
#ASTRA_WORKSPACE=./workspace
#BROWSER_SCREENSHOTS=./data/screenshots

# chat / routing tuning
#CHAT_MAX_TOKENS=
#CHAT_CONTEXT_MAX_CHARS=
#CHAT_CONTEXT_MAX_TURNS=
#AI_MAX_RETRIES=2
#AI_BACKOFF=1.0
#AI_ROUTING_PREFERENCE=fastest
#AI_PROVIDER_LABEL=openai

# permissions
#GRANTED_PERMISSIONS=read low_risk_write browser_action system_action

# shared Terminal
#CHAT_MAX_TOOL_STEPS=8
#CHAT_AGENT_BRAIN=provider
#ASTRA_TERMINAL_SHELL=
#TERMINAL_MAX_OUTPUT_CHARS=20000
#TERMINAL_HISTORY_LIMIT=50

# Astra Agent Runtime
#RUNTIME_CONTAINER=ubuntu
#RUNTIME_PROOT=
#RUNTIME_CONTAINERS_DIR=
#RUNTIME_ROOTFS_MODE=shared
#RUNTIME_DIR=~/.astra/runtime
#RUNTIME_MAX_FILE_MB=512
#RUNTIME_MAX_EXTRACT_MB=2048
#RUNTIME_MAX_MEMBERS=20000
#RUNTIME_BACKEND=auto

# WSL2 backend
#RUNTIME_WSL_DISTRO=Ubuntu
#RUNTIME_WSL_ROOT=/var/lib/astra/runtime
#RUNTIME_WSL_WORKSPACE=
#RUNTIME_WSL_ISOLATE=1
#RUNTIME_WSL_UMASK=000
#RUNTIME_WSL_EXE=

# HOST terminal fallback
#HOST_APPROVAL_TTL_S=900

# Web3 keystore
#ASTRA_MASTER_SECRET=<MANUAL_SECRET>

# FastAPI/ASGI
#ASTRA_ASGI_THREADS=0
#ASTRA_FASTAPI_DOCS=1
