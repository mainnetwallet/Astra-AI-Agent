# Astra AI Agent — copy to `.env` and fill in your keys:  cp .env.example .env
# Multiple keys per provider: comma-separated.


# ══════════════ 1. API KEYS ══════════════

# ── Astra AI Gateway (10 connections, independent from providers) ──
GW_GEMINI_API_KEYS=
GW_GROQ_API_KEYS=
GW_CLOUDFLARE_API_KEYS=
GW_CLOUDFLARE_ACCOUNT_IDS=
GW_BEDROCK_API_KEYS=
#GW_BEDROCK_CREDENTIALS=access_key:secret_key
GW_OPENROUTER_API_KEYS=
GW_MISTRAL_API_KEYS=
GW_CEREBRAS_API_KEYS=
GW_SAMBANOVA_API_KEYS=
GW_COHERE_API_KEYS=
GW_ZAI_API_KEYS=


# ── AI Providers (routed by AstraRouter) ──
GEMINI_API_KEYS=
GROQ_API_KEYS=
CLOUDFLARE_API_KEYS=
CLOUDFLARE_ACCOUNT_IDS=
BEDROCK_API_KEYS=
#BEDROCK_CREDENTIALS=access_key:secret_key
OPENROUTER_API_KEYS=
MISTRAL_API_KEYS=
CEREBRAS_API_KEYS=
SAMBA_API_KEYS=
COHERE_API_KEYS=
ZAI_API_KEYS=


