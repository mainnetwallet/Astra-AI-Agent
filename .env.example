# ─────────────────────────────────────────────────────────────────────────────
#  Astra AI Agent — environment configuration template
# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env` (git-ignored) and fill in what you need.
#     cp .env.example .env
#  Precedence: environment variable > config.json > .env file > default.
#
#  ⚠️ SECURITY
#    * Never commit the real `.env`. It is git-ignored.
#    * Secret values below are placeholders `<MANUAL_SECRET>`. Private keys
#      stay inside the secure signing store — never in any env prompt/log.
#    * Set ASTRA_TOKEN before exposing the UI on a network (BIND=0.0.0.0).
#    * AstraRouter is the CENTRAL routing core and is never configured as a
#      provider itself. The provider adapters below (plus the optional
#      backward-compatible Claude / OpenAI-compatible paths) are the only
#      providers it routes across. It optionally holds a reference to the
#      Astra AI Gateway (GW_* below) — a separate system with four
#      independent AI connections. The Gateway is never a provider and is
#      never used as a fallback provider.
# ─────────────────────────────────────────────────────────────────────────────

# --- server ----------------------------------------------------------------
PORT=8787
# Secure default: loopback only. Use 0.0.0.0 for LAN but set ASTRA_TOKEN first.
BIND=127.0.0.1
# Operator token. When set, every /api/* (and /api/v1/*) call must present it
# via `Authorization: Bearer <token>`, `X-Astra-Token` header, or ?token= for SSE.
#ASTRA_TOKEN=<MANUAL_SECRET>
#ENV=production                # suppresses error details in API responses

# --- web server hardening --------------------------------------------------
#ASTRA_API_RATE_LIMIT=300      # per-IP requests per minute
#ASTRA_MAX_BODY_MB=50          # max request body size
#ASTRA_CORS_ORIGINS=http://localhost:8787 http://127.0.0.1:8787

# --- web research (SSRF guard) ---------------------------------------------
# By default URL research refuses loopback/private/link-local targets.
# Only set to 1 if you truly need internal-network research.
#ASTRA_ALLOW_PRIVATE_URLS=0

# --- backward-compatible single-provider paths (optional) -------------------
# Legacy one-provider paths kept for compatibility. The recommended setup is
# the key-pool adapters further below (GEMINI_*, GROQ_*, …), which support
# multiple keys, model discovery and router failover.
#   * Claude (one Anthropic key):
#ANTHROPIC_API_KEY=<MANUAL_SECRET>
#ANTHROPIC_MODEL=claude-haiku-4-5-20251001
#   * Any OpenAI-compatible endpoint (OpenAI, Ollama, LM Studio, DeepSeek …):
#AI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=gpt-4o
#AI_API_KEY=<MANUAL_SECRET>

# --- multi-provider Model Router (AstraRouter) -------------------------------
# AstraRouter (astra/ai/router.py) is the CENTRAL routing brain. It scores and
# selects among the *provider adapters* below by capability/cost/health/
# priority — it is not itself an API you point at a base URL, has no model
# list, no API key, and no base URL of its own. That is a deliberate design
# choice in this codebase, not a gap: giving the router its own outbound
# endpoint would mean routed requests bypass every one of the per-provider
# adapter's request/response/auth/error/retry handling below. Configure the
# providers you want it to route across instead — each one below is a
# distinct, independently-authenticated backend.
#
# Give the router ONE OR MORE provider key lists. Each value is a comma-
# separated list of keys — unlimited credentials, rotated/round-robined per
# request, with per-key health tracking and cooldown on failure (see
# astra/ai/credentials.py). Leave a provider's key(s) blank/commented to
# leave it unconfigured; Astra starts fine with zero providers configured
# (see "PROVIDER HEALTH" below) and simply won't route to it.
#
# ── Astra AI Gateway ── a SEPARATE multi-service AI gateway
#    (astra/ai/gateway.py). The chat pipeline uses it to UNDERSTAND/ASSIGN
#    each message and to VERIFY the provider's answer (the four GW_*
#    connections are also used when the Gateway itself needs a model). It is
#    NOT a provider and is NEVER used as a fallback when every real provider
#    fails — routing fails honestly in that case. It has exactly four AI
#    connections, each with its own credentials / model list / endpoint
#    (GW_* config) that are completely independent from the provider config
#    on this page (GW_GEMINI_API_KEYS ≠ GEMINI_API_KEYS, etc.). If the
#    Gateway is unusable the pipeline fails open: the message still reaches a
#    provider, just unverified. It is reported separately in health output
#    as "Astra AI Gateway", never in the provider table. Automatic fallback
#    order among its own connections: Gemini → Groq → Cloudflare → Bedrock;
#    the same task/messages/context continue across connections. Leave all
#    GW_* blank to disable it.
#
# ── Astra AI Gateway / Gemini ──
GW_GEMINI_API_KEYS=
GW_GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GW_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#
# ── Astra AI Gateway / Groq ──
GW_GROQ_API_KEYS=
GW_GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GW_GROQ_BASE_URL=https://api.groq.com/openai/v1
#
# ── Astra AI Gateway / Cloudflare ── request URLs are built as
#    /accounts/<id>/ai/v1; the connection round-robins over every id in
#    GW_CLOUDFLARE_ACCOUNT_IDS (the key pool and the account list are
#    independent lists).
GW_CLOUDFLARE_API_KEYS=
GW_CLOUDFLARE_ACCOUNT_IDS=
GW_CLOUDFLARE_MODELS=@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/qwen/qwen2.5-coder-32b-instruct
GW_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
#
# ── Astra AI Gateway / Bedrock ── either a bearer-token Bedrock API key
#    (GW_BEDROCK_API_KEYS) or classic access_key:secret_key IAM pairs
#    (GW_BEDROCK_CREDENTIALS); either is enough. Region via GW_BEDROCK_REGION.
GW_BEDROCK_API_KEYS=
GW_BEDROCK_CREDENTIALS=
GW_BEDROCK_MODELS=us.amazon.nova-lite-v1:0,amazon.nova-lite-v1:0
GW_BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com
GW_BEDROCK_REGION=us-east-1

# ── Google Gemini ── OpenAI-compatible REST endpoint, API-key auth via
#    Authorization: Bearer. Subject to Google's per-key rate limits; the
#    credential pool fails a key over to the next healthy one on 429s.
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ── Groq ── OpenAI-compatible format, extremely low-latency inference.
#    Standard Bearer auth; verify model availability/tier before relying on
#    a specific id, as Groq's hosted catalog changes over time.
GROQ_API_KEYS=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Mistral ── some model ids may require a specific account tier; an
#    unavailable model should fail that one call gracefully rather than
#    take the whole provider down (handled in the credential pool / router).
MISTRAL_API_KEYS=
MISTRAL_MODELS=mistral-small-2603,ministral-14b-2512,ministral-8b-2512,ministral-3b-2512,codestral-2508
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── OpenRouter ── OpenAI-compatible aggregator; ":free" suffixed models are
#    community-hosted and can be rate-limited or withdrawn without notice —
#    treat them as best-effort, not guaranteed-available, and let the router
#    fail over to another configured provider/model when one disappears.
OPENROUTER_API_KEYS=
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,minimax/minimax-m3:free,poolside/laguna-s-2.1:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-super-120b-a12b:free,cohere/north-mini-code:free,minimax/minimax-m2.7:free,dots-studio/dots-3-note-preview:free,inclusionai/ling-3.0-flash-fin:free,poolside/laguna-xs-2.1:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,openrouter/free,liquid/lfm-2.5-2.6b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Cerebras ── OpenAI-compatible, wafer-scale inference hardware.
CEREBRAS_API_KEYS=
CEREBRAS_MODELS=gpt-oss-120b,gemma-4-31b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# ── Cloudflare Workers AI ── multi-account: request URLs are built as
#    /accounts/<id>/ai/v1 and the adapter round-robins over every id in
#    CLOUDFLARE_ACCOUNT_IDS per request (the key pool and the account list
#    are independent lists). A token without at least one account id is
#    treated as unconfigured, because no request URL could be built.
#    Never put a real account id here — this is a template.
CLOUDFLARE_API_KEYS=
CLOUDFLARE_MODELS=@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/meta/llama-3.1-70b-instruct-fp8-fast,@cf/meta/llama-4-scout-17b-16e-instruct,@cf/meta/llama-3.1-8b-instruct-fp8-fast,@cf/meta/llama-3.1-8b-instruct-fp8,@cf/meta/llama-3.2-1b-instruct,@cf/meta/llama-3.2-3b-instruct,@cf/deepseek-ai/deepseek-r1-distill-qwen-32b,@cf/moonshotai/kimi-k2.6,@cf/mistralai/mistral-small-3.1-24b-instruct,@cf/qwen/qwen2.5-coder-32b-instruct,@cf/qwen/qwq-32b,@cf/qwen/qwen3-30b-a3b-fp8,@cf/qwen/qwen3.8-27b,@cf/openai/gpt-oss-120b,@cf/openai/gpt-oss-20b,@cf/google/gemma-4-26b-a4b-it,@cf/aisingapore/gemma-sea-lion-v4-27b-it,@cf/ibm-granite/granite-4.0-h-micro,@cf/zai-org/glm-4.7-flash,@cf/nvidia/nemotron-3-120b-a12b
CLOUDFLARE_ACCOUNT_IDS=
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4

# ── SambaNova ── OpenAI-compatible endpoint on SambaNova's RDU hardware.
SAMBA_API_KEYS=
SAMBA_MODELS=Meta-Llama-3.3-70B-Instruct,DeepSeek-V3.1,gpt-oss-120b
SAMBA_BASE_URL=https://api.sambanova.ai/v1

# ── Cohere ── via Cohere's OpenAI-*compatibility* endpoint (not its native
#    /v1/chat dialect); capabilities vary noticeably across the command-a /
#    aya / tiny-aya families, so pick per task rather than assuming parity.
COHERE_API_KEYS=
COHERE_MODELS=command-a-plus-05-2026,command-a-03-2025,command-a-reasoning-08-2025,command-a-vision-07-2025,command-a-translate-08-2025,command-r7b-12-2024,command-r-plus-08-2024,command-r-08-2024,c4ai-aya-expanse-32b,c4ai-aya-vision-32b,tiny-aya-global,tiny-aya-earth,tiny-aya-fire,tiny-aya-water
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1

# ── Z.AI ── OpenAI-compatible v4 endpoint (GLM model family).
ZAI_API_KEYS=
ZAI_MODELS=glm-4.7-flash,glm-4.5-flash,glm-4.6v-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ── Amazon Bedrock ── two auth modes; either is enough on its own (if both
#    are set, the bearer-token API key takes priority):
#    1. BEDROCK_API_KEYS — a Bedrock API key (bearer token; AWS Console >
#       Bedrock > API keys). Sent as a plain `Authorization: Bearer <key>`
#       header, same as every other adapter here — no request signing.
#    2. BEDROCK_CREDENTIALS — classic `access_key:secret_key` IAM pairs
#       (one per line or comma-separated), signed per-request with AWS
#       Signature V4.
#    Bedrock has no single "global" endpoint -- the runtime host is always
#    region-scoped (bedrock-runtime.<region>.amazonaws.com). Defaulted to
#    us-east-1 below; change the region in the URL if you want a different
#    one. Cross-region routing for some models is done via a model-id
#    PREFIX (e.g. "us.anthropic...."), not the hostname.
#    * Model IDs must be verified against your account/region — not every
#      id below is guaranteed enabled for every account; some marketplace
#      models require an inference profile or ARN rather than a bare id.
#      Unavailable models are marked unavailable per-call, not a startup
#      failure for the whole provider.
BEDROCK_API_KEYS=
#BEDROCK_CREDENTIALS=access_key:secret_key,access_key2:secret_key2
AWS_REGION=us-east-1
BEDROCK_MODELS=us.anthropic.claude-opus-5,us.anthropic.claude-sonnet-5,us.anthropic.claude-fable-5,us.anthropic.claude-opus-4-8,us.anthropic.claude-opus-4-7,us.anthropic.claude-opus-4-6,us.anthropic.claude-opus-4-5,us.anthropic.claude-sonnet-4-6,us.anthropic.claude-sonnet-4-5,us.anthropic.claude-haiku-4-5-20251001,us.anthropic.claude-sonnet-4-20250514-v1:0,amazon.nova-2-sonic-v1:0,us.amazon.nova-2-lite-v1:0,amazon.nova-sonic-v1:0,amazon.nova-lite-v1:0,us.amazon.nova-micro-v1:0,us.amazon.nova-pro-v1:0,us.openai.gpt-5.6-luna,us.openai.gpt-5.6-sol,us.openai.gpt-5.6-terra,openai.gpt-oss-120b-1:0,openai.gpt-oss-20b-1:0,qwen.qwen3-235b-a22b-2507-v1:0,qwen.qwen3-32b,qwen.qwen3-coder-480b-a35b-v1:0,minimax.minimax-m2.5,minimax.minimax-m2.1,moonshotai.kimi-k2.5,zai.glm-5,zai.glm-4.7,zai.glm-4.7-flash,nvidia.nemotron-3-super-120b-v1:0,us.xai.grok-4-6,mistral.devstral-2-123b,mistral.pixtral-large-2502-v1:0,deepseek.v3.2,deepseek.v3.1
BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com

# Router order preference — optional; first healthy provider wins by default.
# Uncomment and edit only if you want to force a specific priority order:
#AI_PROVIDER=gemini groq openrouter

# --- Web3 transaction safety -------------------------------------------------
# Transaction mode: CONFIRM (every send needs your manual review — DEFAULT)
# or AUTO (only allowlist-passing, deterministic-policy txs auto-send).
# The LLM can NEVER change this; only the operator (with ASTRA_TOKEN) can.
#WEB3_TRANSACTION_MODE=CONFIRM
# Operational limits (wei; 1 ETH = 10^18 wei):
#WEB3_MAX_TX_VALUE_WEI=1000000000000000000        # 1 ETH per tx
#WEB3_MAX_DAILY_TX_VALUE_WEI=5000000000000000000  # 5 ETH / day
#WEB3_MAX_GAS_LIMIT=8000000
# Allowlists (space-separated checksums) — send only to these:
#WEB3_ALLOWED_RECIPIENTS=0x0000000000000000000000000000000000000000
#WEB3_ALLOWED_CONTRACTS=0x1111111111111111111111111111111111111111
#WEB3_ALLOWED_WALLETS=0x2222222222222222222222222222222222222222
# Chain whitelist (chain ids):
#WEB3_CHAIN_IDS=1 8453 137 56 42161 10 11155111

# --- browser / system --------------------------------------------------------
#NO_BROWSER=1                # do not auto-open the web UI

# --- storage ----------------------------------------------------------------
#DATA_DIR=./data             # SQLite database location
#ASTRA_SCHEDULER=1           # start the scheduler daemon at boot

# --- storage (continued) -----------------------------------------------------
#DATABASE=./data/astra.db    # exact SQLite file; overrides DATA_DIR when set.
#                            # Uploaded files live in $DATA_DIR/uploads.
#ASTRA_WORKSPACE=./workspace # sandbox root for the file read/write/search tools
#BROWSER_SCREENSHOTS=./data/screenshots   # where browser screenshots are written

# --- chat / routing tuning ---------------------------------------------------
#CHAT_MAX_TOKENS=1500        # max tokens the provider may return for one chat turn
#AI_MAX_RETRIES=2            # per-(provider,model) retries before failing over
#AI_BACKOFF=1.0              # base seconds for retry backoff (capped at 8s/attempt)
#AI_ROUTING_PREFERENCE=balanced  # balanced | fastest | best_quality | lowest_cost
#AI_PROVIDER_LABEL=openai    # display name for the AI_BASE_URL provider path

# --- permissions -------------------------------------------------------------
# Space-separated tool risk levels auto-granted without confirmation.
# Valid: read low_risk_write browser_action financial_action system_action admin
# `system_action` powers the shared Terminal (astra/terminal/). Remove it to
# fail every terminal tool closed ("denied by policy").
#GRANTED_PERMISSIONS=read low_risk_write browser_action system_action

# --- shared Terminal ---------------------------------------------------------
#CHAT_MAX_TOOL_STEPS=8          # max tool calls per chat turn (agent tool loop)
#CHAT_AGENT_BRAIN=provider      # provider | gateway — which AI drives the tool loop
#ASTRA_TERMINAL_SHELL=          # override shell (bash/sh, pwsh, cmd); auto-detected
#TERMINAL_MAX_OUTPUT_CHARS=20000  # per-command stdout/stderr cap per session
#TERMINAL_HISTORY_LIMIT=50      # commands kept in each session's history

# --- Web3 keystore (security-critical) ---------------------------------------
# Master secret used to encrypt stored wallet keys. Set this, or provide the
# 64-hex-char key file at data/.master_key. Never commit it.
#ASTRA_MASTER_SECRET=<MANUAL_SECRET>

# --- FastAPI/ASGI ------------------------------------------------------------
#ASTRA_ASGI_THREADS=0        # 0 = Starlette default (40); raise for heavy concurrency
#ASTRA_FASTAPI_DOCS=1        # expose /docs + /openapi.json (off by default)

# --- legacy / no-op ----------------------------------------------------------
# The plugin loader was removed; ACTIVE_PLUGINS only feeds the public-config
# "plugins" count and loads nothing. Leave unset.
#ACTIVE_PLUGINS=
